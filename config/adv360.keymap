#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hmr_i: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <210>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <350>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <15 16 1 4 5 3 2 17 18 19 33 32 31 30 29 47 48 50 49 51 65 66 35 36 52 67 47 61 62 63 64>;
        };

        hml_i: hml_i {
            compatible = "zmk,behavior-hold-tap";
            label = "HML_I";
            #binding-cells = <2>;
            tapping-term-ms = <210>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <350>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <22 23 24 26 25 44 43 42 41 40 54 55 56 57 58 12 11 10 9 8 37 38 53 68 69 70 71 72 73 74>;
        };

        hmr_m: hmr_m {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_M";
            #binding-cells = <2>;
            tapping-term-ms = <260>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <350>;
            require-prior-idle-ms = <200>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <15 16 1 4 5 3 2 17 18 19 33 32 31 30 29 47 48 50 49 51 65 66 35 36 52 67 47 61 62 63 64>;
        };

        hmr_r: hmr_r {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_R";
            #binding-cells = <2>;
            tapping-term-ms = <290>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <350>;
            require-prior-idle-ms = <200>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <15 16 1 4 5 3 2 17 18 19 33 32 31 30 29 47 48 50 49 51 65 66 35 36 52 67 47 61 62 63 64>;
        };

        hmr_p: hmr_p {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_P";
            #binding-cells = <2>;
            tapping-term-ms = <330>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <350>;
            require-prior-idle-ms = <200>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <15 16 1 4 5 3 2 17 18 19 33 32 31 30 29 47 48 50 49 51 65 66 35 36 52 67 47 61 62 63 64>;
        };

        hml_m: hml_m {
            compatible = "zmk,behavior-hold-tap";
            label = "HML_M";
            #binding-cells = <2>;
            tapping-term-ms = <260>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <350>;
            require-prior-idle-ms = <200>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <22 23 24 26 25 44 43 42 41 40 54 55 56 57 58 12 11 10 9 8 37 38 53 68 69 70 71 72 73 74>;
        };

        hml_p: hml_p {
            compatible = "zmk,behavior-hold-tap";
            label = "HML_P";
            #binding-cells = <2>;
            tapping-term-ms = <330>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <350>;
            require-prior-idle-ms = <200>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <22 23 24 26 25 44 43 42 41 40 54 55 56 57 58 12 11 10 9 8 37 38 53 68 69 70 71 72 73 74>;
        };

        hml_r: hml_r {
            compatible = "zmk,behavior-hold-tap";
            label = "HML_R";
            #binding-cells = <2>;
            tapping-term-ms = <290>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <350>;
            require-prior-idle-ms = <200>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <22 23 24 26 25 44 43 42 41 40 54 55 56 57 58 12 11 10 9 8 37 38 53 68 69 70 71 72 73 74>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1                 &kp N2             &kp N3             &kp N4               &kp N5  &tog 1                                                         &mo 3      &kp N6  &kp N7                &kp N8              &kp N9              &kp N0                  &kp MINUS
&kp TAB    &kp Q                  &kp W              &kp F              &kp P                &kp B   &none                                                          &none      &kp J   &kp L                 &kp U               &kp Y               &kp SEMICOLON           &kp BSLH
&kp ESC    &hml_p LEFT_CONTROL A  &hml_r LEFT_ALT R  &hml_m LEFT_GUI S  &hml_i LEFT_SHIFT T  &kp G   &none       &kp LCTRL      &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp M   &hmr_i RIGHT_SHIFT N  &hmr_m RIGHT_GUI E  &hmr_i RIGHT_ALT I  &hmr_p RIGHT_CONTROL O  &kp SQT
&kp LSHFT  &kp Z                  &kp X              &kp C              &kp D                &kp V                              &kp HOME      &kp PG_UP                        &kp K   &kp H                 &kp COMMA           &kp DOT             &kp FSLH                &kp RSHFT
&mo 2      &kp GRAVE              &kp CAPS           &kp LEFT           &kp RIGHT                    &kp RETURN  &kp BACKSPACE  &mo 2         &mo 1      &kp TAB    &kp SPACE          &kp UP                &kp DOWN            &kp LBKT            &kp RBKT                &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2            &kp N3          &kp N4                &kp N5  &trans                                                   &mo 3      &kp N6  &kp KP_NUM             &kp KP_EQUAL     &kp KP_DIVIDE      &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W             &kp E           &kp R                 &kp T   &none                                                    &none      &kp Y   &kp KP_N7              &kp KP_N8        &kp KP_N9          &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp LEFT_BRACKET  &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X             &kp C           &kp V                 &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1              &kp KP_N2        &kp KP_N3          &kp KP_ENTER     &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS          &kp LEFT        &kp RIGHT                     &kp BSPC  &kp DEL    &mo 2         &mo 1      &kp ENTER  &kp KP_N0          &kp UP                 &kp DOWN         &kp KP_DOT         &kp RBKT         &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 3   &kp F7    &kp F8    &kp F9  &kp F10    &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans    &trans    &trans  &trans     &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans    &trans    &trans  &trans     &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans            &trans    &trans  &trans     &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
